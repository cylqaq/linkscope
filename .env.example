# Database
DATABASE_URL=postgresql://linkscope:linkscope123@localhost:5432/linkscope
POSTGRES_PASSWORD=linkscope123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# AI - Default: DeepSeek
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AI - Fallback (optional)
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
PORT=3001
# 浏览器访问前端的地址（CORS）；局域网调试可设为 http://192.168.x.x:3000 等
WEB_URL=http://localhost:3000
# 可选：额外允许的 Origin，逗号分隔（直连 API 跨域时用）
# CORS_EXTRA_ORIGINS=http://172.22.32.1:3000

# Next 服务端把 /api/* rewrite 到 Nest；Docker 内可写 http://api:3001/api
API_URL=http://127.0.0.1:3001/api
# 留空则浏览器走同源 /api（推荐本地与 LAN IP 访问，无 CORS）。
# 前后端分离部署时再设为完整 API 根，例如 https://api.example.com/api
# NEXT_PUBLIC_API_URL=

SCREENSHOT_DIR=./screenshots

# 智能等待配置
BROWSER_SMART_WAIT=true
BROWSER_WAIT_MIN=3000
BROWSER_WAIT_MAX=15000
BROWSER_WAIT_DEFAULT=5000

# 反爬虫配置
ANTI_DETECTION_TLS_FINGERPRINT=true
ANTI_DETECTION_BROWSER_FINGERPRINT=true
ANTI_DETECTION_BEHAVIOR_SIM=true
ANTI_DETECTION_HEADER_ORDER=true
ANTI_DETECTION_RESIDENTIAL_PROXY=false
# 代理服务器列表（逗号分隔），例如：http://proxy1:8080,http://proxy2:8080
ANTI_DETECTION_PROXIES=
# 请求超时时间（毫秒）
ANTI_DETECTION_TIMEOUT_MS=15000
# 最大重定向次数
ANTI_DETECTION_MAX_REDIRECTS=10
# 自定义 User-Agent 列表（每行一个）
# ANTI_DETECTION_USER_AGENTS=Mozilla/5.0 ...

# 域名级限速配置
# 每域名每秒最大请求数
RATE_LIMIT_PER_DOMAIN=2
# 每域名最大并发数
RATE_LIMIT_MAX_CONCURRENT=5
# 突发请求容量
RATE_LIMIT_BURST_CAPACITY=10
# 清理空闲桶的间隔（毫秒）
RATE_LIMIT_CLEANUP_INTERVAL=60000
# 桶空闲超时时间（毫秒）
RATE_LIMIT_BUCKET_IDLE_TIMEOUT=300000
